# Luminar backend environment. Copy to `.env` (gitignored); `make backend`, `make dev` and `./start.sh`
# load it. Every key is optional: the value shown is the default the code uses when the key is unset.
# Browser-side keys (NEXT_PUBLIC_*) live in web/.env.example, because Next.js reads env files from web/ only.

# ── Simulation ───────────────────────────────────────────────
# Simulated peers at startup (the API clamps 2–500; the UI presets are 20 · 50 · 100 · 200).
LUMINAR_NODE_COUNT=20
# DEBUG, INFO, WARNING or ERROR.
LUMINAR_LOG_LEVEL=INFO
# Event ring buffer size (events kept in memory for replay and the log).
LUMINAR_RING_SIZE=50000

# ── Server ───────────────────────────────────────────────────
# Port for ./start.sh and the Docker image (`make backend` / `make dev` always use 8000).
PORT=8000

# ── Security (set these on any public deploy) ────────────────
# When set, every mutating request (play, reset, faults, scenarios, telemetry) must send it in the
# X-Luminar-Token header. Empty = no gate (fine locally). Generate one: `openssl rand -hex 32`.
LUMINAR_ADMIN_TOKEN=
# 1 allows `?record=<name>` on /ws/events to write reel files to disk. Local recording only:
# never set this on a public deploy.
LUMINAR_ALLOW_RECORD=

# ── Live Ethereum mainnet ────────────────────────────────────
# 1 starts the mainnet arrival poller (ethPandaOps) at boot instead of waiting for the MAINNET toggle.
LUMINAR_MAINNET_FEED=

# ── Observability (make otel-up) ─────────────────────────────
# OTLP/HTTP collector for traces, e.g. http://localhost:4318. Empty = no trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Percentage of gossip messages exported as traces (0–100).
LUMINAR_OTLP_TRACE_PCT=5
