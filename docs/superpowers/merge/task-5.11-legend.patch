 }
+
+/* Stage (projector): the glyph rows grow with --row-h (22 -> 26 px) and the plate glyphs scale with them (task 5.11).
+   ponytail: 26/22 is hardcoded; derive it if --row-h changes again. */
+:global(:root[data-stage="1"]) .body { grid-template-columns: var(--row-h) 1fr; }
+:global(:root[data-stage="1"]) .body dt { min-height: var(--row-h); align-items: center; }
+:global(:root[data-stage="1"]) .body dt > svg { scale: calc(26 / 22); }
