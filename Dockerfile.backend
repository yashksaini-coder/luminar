# Backend only (API + /ws/events): for hosts where the site is served elsewhere (Vercel → Render).
# No frontend/dist in the image, so main.py skips the static mount. Full stack in one image: ./Dockerfile
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen

COPY backend/ backend/

EXPOSE 8080

ENV LUMINAR_NODE_COUNT=20
ENV LUMINAR_LOG_LEVEL=INFO
ENV PORT=8080

CMD ["sh", "-c", "uv run uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
