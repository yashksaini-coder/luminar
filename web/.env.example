# Luminar web environment. Copy to `web/.env.local` (gitignored) for local overrides; on Vercel, add
# these as **Config** variables (not Secret): NEXT_PUBLIC_* values are compiled into the browser bundle,
# so they are public by design. All three are read at build time.

# Backend origin when the site and the API are on different hosts (Vercel → Render). Leave EMPTY when the
# backend serves the site itself (Docker, Render, DigitalOcean, ./start.sh): requests then go same-origin.
# Example: https://luminar-backend.onrender.com
NEXT_PUBLIC_API_URL=

# The site's public origin, used for Open Graph / social preview image URLs.
# Example: https://luminar.vercel.app (unset = http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Dev only: where `npm run dev` opens the live socket (the dev server proxies /api but not /ws).
# Unset = ws://localhost:8000
NEXT_PUBLIC_WS_URL=
